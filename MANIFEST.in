include README.md
include readme.md
include requirements.txt
include quickstart.txt
include launch_assistant.bat
include launch_assistant.py
include setup.py
include pyproject.toml
recursive-include pokerflex *.py
recursive-include pokerflex *.json
global-exclude __pycache__/*
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.log
global-exclude clubgg_*.json
global-exclude clubgg_*.png
global-exclude player_notes.json
prune __pycache__
prune .git
prune .github
prune venv
prune env
